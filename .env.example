# ─────────────────────────────────────────────────────
#  .env.example — Template for environment variables
#  Copy to .env and fill in your free-tier API keys
# ─────────────────────────────────────────────────────

# ───── Google Gemini (Free) ─────────────────────────
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ───── Reddit API via PRAW (Free) ───────────────────
# Create an app at: https://reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MyntraDiscoveryEngine/1.0 by /u/your_username

# ───── Apify Reddit Scraper (Optional, Free $5/mo) ──
# Get token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# ───── Database ─────────────────────────────────────
DB_PATH=data/myntra_discovery.db

# ───── LLM Config ──────────────────────────────────
LLM_MODEL=gemini-3.6-flash
LLM_RPM_LIMIT=15
LLM_DAILY_TOKEN_LIMIT=1000000

# ───── Dashboard ────────────────────────────────────
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0
